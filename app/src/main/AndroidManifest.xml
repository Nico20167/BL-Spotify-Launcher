<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluetooth legacy : accordé à l'installation, utilisé seulement jusqu'à Android 11 (API 30). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Bluetooth moderne : permission runtime à partir d'Android 12 (API 31).
         Indispensable pour lister les bonded devices et recevoir les events de connexion. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Notifications : permission runtime à partir d'Android 13 (API 33).
         Requise pour la notification du foreground service. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service + type connectedDevice (permission requise sur API 34+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Relance du service après redémarrage du téléphone. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Demande directe d'exemption d'optimisation batterie (sinon certains OEM
         tuent le service). Usage personnel : OK ; une publication Play Store
         exigerait de justifier cette permission. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Mode sans SDK : « Afficher par-dessus les autres apps » est l'exemption
         qui autorise l'ouverture de Spotify depuis l'arrière-plan (Android 10+).
         Accordée manuellement par l'utilisateur dans les réglages. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Android 11+ : visibilité de l'app Spotify (détection d'installation).
         Le .aar du SDK le déclare aussi, mais le mode sans SDK ne doit pas en dépendre. -->
    <queries>
        <package android:name="com.spotify.music" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BluetoothSpotifyTrigger">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".bluetooth.BluetoothMonitorService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Écoute de notifications VIDE : sert uniquement de « clé » pour accéder
             aux sessions média (mode aléatoire de Spotify). Activé par l'utilisateur
             via « Accès aux notifications ». -->
        <service
            android:name=".spotify.MediaAccessListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- BOOT_COMPLETED / MY_PACKAGE_REPLACED sont des broadcasts protégés
             (émis par le système uniquement) : exported="true" sans risque. -->
        <receiver
            android:name=".bluetooth.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
