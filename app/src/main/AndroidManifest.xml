<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Bluetooth legacy : accordé à l'installation, utilisé seulement jusqu'à Android 11 (API 30). -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />

    <!-- Bluetooth moderne : permission runtime à partir d'Android 12 (API 31).
         Indispensable pour lister les bonded devices et recevoir les events de connexion. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Notifications : permission runtime à partir d'Android 13 (API 33).
         Requise pour la notification du foreground service. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Foreground service + type connectedDevice (permission requise sur API 34+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BluetoothSpotifyTrigger">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".bluetooth.BluetoothMonitorService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

    </application>

</manifest>
